{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyAccounting",
  "version": "0.2.0",
  "identifier": "com.welllhq.easyaccounting",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "轻账本 · EasyAccounting",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "portable"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
